<!DOCTYPE html>
<html dir="rtl" lang="ar">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>الملف الشخصي — منصة تعلَّم</title>

<link href="https://fonts.googleapis.com" rel="preconnect">
<link crossorigin href="https://fonts.gstatic.com" rel="preconnect">
<link href="https://fonts.googleapis.com/css2?family=Aref+Ruqaa:wght@400;700&family=Katibeh&family=Reem+Kufi:wght@400;500;600;700&family=Tajawal:wght@400;500;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/profile.css">
</head>

<body>

<header class="site-header">
  <div class="header-inner">
    <div class="header-start">
      <a class="logo-box" href="/"><span class="logo-title">تعلَّم</span></a>
      <nav class="header-nav" aria-label="التنقل الرئيسي">
        <a href="/">الرئيسية</a>
        <a href="/book">حجز حصة</a>
        <a class="active" href="/profile">الملف الشخصي</a>
      </nav>
    </div>
    <div class="header-end">
      <form method="POST" action="/logout" style="margin:0">
        <button class="back-home-btn" type="submit"><span>تسجيل الخروج</span><span>←</span></button>
      </form>
      <button class="menu-toggle" id="menuToggle" type="button" aria-label="القائمة" aria-expanded="false" aria-controls="mobileNav">
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
  <nav class="mobile-nav" id="mobileNav" aria-label="قائمة الجوال">
    <a href="/">الرئيسية</a>
    <a href="/book">حجز حصة</a>
    <a class="active" href="/profile">الملف الشخصي</a>
    <form method="POST" action="/logout" style="margin:0">
      <button type="submit" style="padding:12px 16px;border-radius:8px;color:var(--c1);font-family:var(--font-display);font-weight:700;width:100%;text-align:right;">تسجيل الخروج</button>
    </form>
  </nav>
</header>

<main class="main-content">
  <div class="container">

    <%- include('partials/alert') %>

    <section class="profile-card">
      <div class="avatar-badge-wrap">
        <div class="avatar-circle"><%= student.f_name.charAt(0) %></div>
        <div class="verified-icon" title="حساب طالب">✓</div>
      </div>

      <div class="profile-info">
        <h1><%= student.f_name %> <%= student.l_name %></h1>
        <div class="profile-subtitle">
          <span class="tag-track">طالب</span>
        </div>
        <div class="profile-meta-row">
          <div class="profile-meta-item"><span class="bullet">◆</span><span><%= user.email %></span></div>
          <% if (student.phone_number) { %>
            <div class="profile-meta-item"><span class="bullet">◆</span><span dir="ltr"><%= student.phone_number %></span></div>
          <% } %>
          <div class="profile-meta-item"><span class="bullet">◆</span><span>انضم في <%= fmtMonth(user.created_at) %></span></div>
        </div>
      </div>

      <div class="profile-actions">
        <a class="btn-primary" href="/book">حجز حصة جديدة</a>
      </div>
    </section>

    <section class="stats-grid">
      <div class="stat-card">
        <div class="stat-header"><span class="stat-badge">إجمالي الحجوزات</span><span aria-hidden="true">📚</span></div>
        <div class="stat-num"><%= stats.total %></div>
        <div class="stat-label">حجز منذ انضمامك</div>
      </div>
      <div class="stat-card featured">
        <div class="stat-header"><span class="stat-badge">القادمة</span><span aria-hidden="true">⏱</span></div>
        <div class="stat-num"><%= stats.upcoming %></div>
        <div class="stat-label">حصص قادمة مؤكدة</div>
      </div>
      <div class="stat-card">
        <div class="stat-header"><span class="stat-badge">المنجزة</span><span aria-hidden="true">🎖</span></div>
        <div class="stat-num"><%= stats.completed %></div>
        <div class="stat-label">حصص مكتملة</div>
      </div>
      <div class="stat-card">
        <div class="stat-header"><span class="stat-badge">الملغاة</span><span aria-hidden="true">📈</span></div>
        <div class="stat-num"><%= stats.canceled %></div>
        <div class="stat-label">حجوزات ملغاة</div>
      </div>
    </section>

    <div class="layout-grid">

      <div class="main-column">

        <section class="content-box">
          <div class="box-head">
            <div class="box-title-wrap">
              <div class="box-icon">١</div>
              <h2>حصصي القادمة</h2>
            </div>
            <a class="box-sublink" href="/book">حجز حصة جديدة ←</a>
          </div>

          <% if (!upcoming.length) { %>
            <p class="track-desc">لا توجد لديك حصص قادمة. <a class="box-sublink" href="/book">تصفح المواعيد المتاحة</a></p>
          <% } %>

          <% upcoming.forEach(b => { %>
            <div class="track-item">
              <div class="track-header">
                <div class="track-title"><%= b.subject || 'حصة دراسية' %></div>
                <div class="track-teacher">المعلم: <%= b.title || '' %> <%= b.full_name %></div>
              </div>
              <p class="track-desc"><%= fmtDate(b.slot_date) %> • <%= fmtTime(b.start_time) %> - <%= fmtTime(b.end_time) %></p>
              <div class="track-footer-action">
                <% if (b.join_url) { %><a class="btn-track" href="<%= b.join_url %>" target="_blank" rel="noopener noreferrer">انضم عبر Zoom 🎥</a><% } %>
                <form method="POST" action="/bookings/<%= b.id %>/cancel" style="margin:0" onsubmit="return confirm('هل تريد إلغاء هذا الحجز؟');">
                  <button class="btn-track" type="submit">إلغاء الحجز</button>
                </form>
              </div>
            </div>
          <% }) %>
        </section>

        <section class="content-box">
          <div class="box-head">
            <div class="box-title-wrap">
              <div class="box-icon">٢</div>
              <h2>السجل السابق</h2>
            </div>
            <span class="tag-track"><%= history.length %> سجل</span>
          </div>

          <% if (!history.length) { %>
            <p class="track-desc">لا يوجد سجل سابق بعد.</p>
          <% } %>

          <div class="certs-grid">
            <% history.forEach(b => { %>
              <div class="cert-card">
                <div>
                  <span class="cert-tag"><%= b.status === 'cancelled' ? 'ملغاة' : 'مكتملة' %></span>
                  <div class="cert-title"><%= b.subject || 'حصة دراسية' %> — <%= b.title || '' %> <%= b.full_name %></div>
                  <div class="cert-meta"><%= fmtDate(b.slot_date) %> • <%= fmtTime(b.start_time) %></div>
                </div>
              </div>
            <% }) %>
          </div>
        </section>

      </div>

      <aside class="sidebar-column">

        <div class="sidebar-widget">
          <div class="widget-head"><h3>الجلسات القادمة</h3></div>
          <% if (!upcoming.length) { %>
            <p class="note-text">لا توجد جلسات مجدولة.</p>
          <% } %>
          <% upcoming.slice(0, 3).forEach((b, i) => { %>
            <div class="schedule-item <%= i === 0 ? 'today' : '' %>">
              <div class="schedule-date"><%= fmtDate(b.slot_date) %> • <%= fmtTime(b.start_time) %></div>
              <div class="schedule-title"><%= b.subject || 'حصة دراسية' %></div>
              <div class="schedule-meta"><span><%= b.title || '' %> <%= b.full_name %></span><span class="schedule-status">مؤكد</span></div>
            </div>
          <% }) %>
        </div>

      </aside>
    </div>
  </div>
</main>

<footer class="site-footer">
  <div class="footer-inner">
    <div class="footer-bottom">
      <span>© 2026 منصة تعلَّم التعليمية. كافة الحقوق محفوظة.</span>
      <div class="footer-meta"><span>مؤسسة تعليمية معتمدة</span><span>◆</span></div>
    </div>
  </div>
</footer>

<script>
  (function () {
    var btn = document.getElementById('menuToggle');
    var nav = document.getElementById('mobileNav');
    if (!btn || !nav) return;
    function setOpen(o) { nav.classList.toggle('open', o); btn.setAttribute('aria-expanded', o); }
    btn.addEventListener('click', function () { setOpen(!nav.classList.contains('open')); });
    nav.addEventListener('click', function (e) { if (e.target.tagName === 'A') setOpen(false); });
  })();
</script>
</body>
</html>
