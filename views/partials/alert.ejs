<% if (locals.error) { %>
  <div role="alert" style="background:#FEF2F2;border:2px solid #DC2626;color:#991B1B;padding:10px 14px;border-radius:10px;margin-bottom:16px;font-weight:700;"><%= error %></div>
<% } %>
<% if (locals.notice) { %>
  <div role="status" style="background:#E6FFFA;border:2px solid #009990;color:#005E58;padding:10px 14px;border-radius:10px;margin-bottom:16px;font-weight:700;"><%= notice %></div>
<% } %>
